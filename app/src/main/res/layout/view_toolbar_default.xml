<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbarScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="?android:attr/colorBackground"
    android:elevation="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/quickAiButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/round_auto_awesome_24"
            app:navText="@string/eia_tool_ai" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/quickMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/eia_ic_media"
            app:navText="@string/eia_tool_media" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/quickAudioButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/eia_ic_music"
            app:navText="@string/eia_tool_audio" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/quickTextButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/eia_ic_text"
            app:navText="@string/text" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/quickEffectButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/eia_ic_effects"
            app:navText="@string/effect" />

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="6dp"
            android:alpha="0.25"
            android:background="?android:attr/textColorSecondary" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/addTrackButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_add_24"
            app:navText="@string/add" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/reorderTracksButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_sort_24"
            app:navText="@string/order" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/deleteMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_delete_24"
            app:navText="@string/delete" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/splitMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_content_cut_24"
            app:navText="@string/cut" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/pasteMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_content_paste_24"
            app:navText="@string/paste" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/projectFilesViewerButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_folder_24"
            app:navText="@string/files" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/importTrackButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_data_object_24"
            app:navText="@string/add_project_choice_import" />

    </LinearLayout>
</HorizontalScrollView>